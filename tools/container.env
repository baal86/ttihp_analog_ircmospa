# Setup PDK to IHP SG13G2
PDK_ROOT=/foss/pdks
PDK=ihp-sg13g2
PDKPATH=/foss/pdks/ihp-sg13g2
STD_CELL_LIBRARY=sg13g2_stdcell
SPICE_USERINIT_DIR=/foss/pdks/ihp-sg13g2/libs.tech/ngspice
KLAYOUT_PATH=/headless/.klayout:/foss/pdks/ihp-sg13g2/libs.tech/klayout

# Machine specific (Windows11 + WSL2 + VCXSRV) X-Server config.
DISPLAY=localhost:0
LIBGL_ALWAYS_INDIRECT=1
WAYLAND_DISPLAY=
XDG_SESSION_TYPE=x11 